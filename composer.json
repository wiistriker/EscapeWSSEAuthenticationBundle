{
    "name": "escapestudios/wsse-authentication-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to implement WSSE authentication",
    "keywords": ["wsse", "authentication", "bundle"],
    "homepage": "https://github.com/djoos/EscapeWSSEAuthenticationBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "David Joos",
            "email": "david.joos@escapestudios.com"
        },
        {
            "name": "Community contributors",
            "homepage": "https://github.com/djoos/EscapeWSSEAuthenticationBundle/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/password-hasher": "^5.4 || ^6.0 || ^7.0",
        "symfony/security-bundle": "^5.4 || ^6.0 || ^7.0",
        "symfony/security-core": "^5.4 || ^6.0 || ^7.0",
        "symfony/security-http": "^5.4 || ^6.0 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/cache": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": { "Escape\\WSSEAuthenticationBundle\\": "" },
        "exclude-from-classmap": [ "/Tests/" ]
    }
}
